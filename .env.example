# Copy to .env before `npm run docker:up`.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Host port for the nginx client (http://localhost:8080).
CLIENT_PORT=8080

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Local http on localhost: keep COOKIE_SECURE=false and COOKIE_SAME_SITE=lax.
# Behind HTTPS: COOKIE_SECURE=true (and COOKIE_SAME_SITE=lax when same-origin).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Only for a split client/API deployment; requires rebuilding the client image.
# Leave empty to use the nginx same-origin proxy (recommended).
VITE_API_URL=
CLIENT_ORIGIN=http://localhost:8080
