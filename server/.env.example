PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/live-study-room
JWT_SECRET=replace-this-in-development
CLIENT_ORIGIN=http://localhost:5173

# Access tokens are short-lived; the refresh cookie is used to renew them.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Set COOKIE_SECURE=true (and COOKIE_SAME_SITE=none) when the client and API
# are on different sites, e.g. a Vercel frontend calling a Render backend.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
