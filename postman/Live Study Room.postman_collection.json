            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Algorithms deep work\",\n  \"description\": \"Two hours of focused practice\",\n  \"subject\": \"Computer Science\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            }
          }
        },
        {
          "name": "Join room",
          "event": [
