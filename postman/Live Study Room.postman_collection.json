{
  "info": {
    "_postman_id": "b6f0f6a4-6a9e-4c2f-9c1a-7c5f0f2d9a11",
    "name": "Live Study Room API",
    "description": "Auth (short-lived access token + rotating refresh token cookie), rooms, and the socket handshake token.\n\nHow to use:\n1. Select the `Live Study Room - Local` environment.\n2. Run `Auth > Login` (or `Register`) once. The access token is saved to the collection variable automatically.\n3. The collection pre-request script silently refreshes an expired access token.\n\nThe refresh token lives in an httpOnly cookie, so Postman's cookie jar handles it. Keep **Send cookies** enabled and use the same host for every request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url = pm.request.url.toString();",
          "if (/\\/(register|login|refresh)$/.test(url)) return;",
          "",
          "const baseUrl = pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "const accessToken = pm.collectionVariables.get('accessToken');",
          "let expired = !accessToken;",
          "if (accessToken) {",
          "  try {",
          "    const payload = JSON.parse(atob(accessToken.split('.')[1]));",
          "    expired = !payload.exp || payload.exp * 1000 < Date.now() + 30000;",
          "  } catch (e) {",
          "    expired = true;",
          "  }",
          "}",
          "if (!expired) return;",
          "",
          "pm.sendRequest({ url: `${baseUrl}/api/auth/refresh`, method: 'POST' }, (err, res) => {",
          "  if (err || res.code !== 200) return;",
          "  const data = res.json();",
          "  pm.collectionVariables.set('accessToken', data.token);",
          "  pm.collectionVariables.set('userId', data.user.id);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('accessToken', data.token);",
                  "  pm.collectionVariables.set('userId', data.user.id);",
                  "}",
                  "pm.test('Returns an access token', () => pm.expect(data.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
